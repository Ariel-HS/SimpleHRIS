NODE_ENV=development
PORT=3000

# React dev server origin(s); 
CORS_ORIGIN=http://localhost:5173

# --- Oracle ---
DB_HOST=localhost
DB_PORT=1521

# Oracle SERVICE NAME (not a schema). Oracle Free container = FREEPDB1; XE = XEPDB1 (If not using)
DB_SERVICE_NAME=FREEPDB1
DB_USERNAME=hris
DB_PASSWORD=hris
# true = TypeORM auto-creates/alters tables. Local dev only.
DB_SYNCHRONIZE=true

# --- Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- First admin, created on first start if missing ---
SEED_SUPERADMIN_NAME=admin
SEED_SUPERADMIN_EMAIL=admin@simplehris.local
SEED_SUPERADMIN_PASSWORD=admin

# --- Optional telemetry (leave empty to skip) ---
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Timezone for Date
TIME_ZONE='Asia/Jakarta'

# Time for on-time check in
CHECK_IN_TIME='09:00:00' 